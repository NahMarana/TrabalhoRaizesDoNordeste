@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - lista com todos os usuários ativos
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/
Accept: application/json

###

//Esperado: 200 - Buscar usuário por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/10
Accept: application/json

###

//Esperado: 200 - Buscar usuário por nome
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/buscar?nome=Neusa
Accept: application/json

###


//Esperado: 200 - Listar funcionários inativos
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/funcionarios/inativos
Accept: application/json

###


