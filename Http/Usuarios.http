//------------ ACERTOS: DESATIVAÇÃO e GETS (no lugar do DELETE) ------------

//Esperado: 200 - "Usuário desativado com sucesso!" (registra DESATIVAR_USUARIO no log)
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/15/desativar
Accept: application/json

###

//Esperado: 200 - lista com usuários inativos
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/funcionarios/inativos
Accept: application/json

###

//Esperado: 200 - lista com usuários ativos
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/
Accept: application/json

###

//------------ ERROS: DESATIVAÇÃO ------------

//Esperado: 409 - "Este usuário está inativo."
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/15/desativar
Accept: application/json


###

//Esperado: 400 - "ID fornecido é inválido."
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/0/desativar
Accept: application/json

###

//Esperado: 404 - "Usuário não encontrado."
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/9999/desativar
Accept: application/json

###

//Esperado: 405 - Method Not Allowed
DELETE {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/1
Accept: application/json

