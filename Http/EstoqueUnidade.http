@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - lista com todos os produtos e estabelecimento por estoques criados
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/
Accept: application/json

###

//Esperado: 200 - Verificar estoque suficiente - "possuiEstoque": true
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/verificar?estabelecimentoId=4&produtoId=28
Accept: application/json

###

//Esperado: 200 - Verificar estoque insuficiente - "possuiEstoque": false
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/verificar?estabelecimentoId=4&produtoId=3
Accept: application/json

###

//------------ CARDÁPIO DAS UNIDADES (depois do estoque) ------------

//Esperado: 200 - Cardápio da unidade COMPLETA de Recife Sem Pratos Sazonais(fora de epoca)
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/4/cardapio
Accept: application/json

###

//Esperado: 200 - Cardápio da unidade REDUZIDA de Maceió - Sem Pratos Sazonais(fora de epoca)
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/9/cardapio
Accept: application/json

###

//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/0
Accept: application/json

###


//Esperado: 404 - "Estoque por ID não encontrado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/9999
Accept: application/json

###

//Esperado: 400 - "Unidade e produto são obrigatórios."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/verificar?estabelecimentoId=0&produtoId=37&quantidade=10
Accept: application/json

###

//Verificar produto que a unidade não tem em estoque (Baião de dois na unidade Maceió, que é REDUZIDA e não recebe PF)
//Esperado: 404 - "Não existe estoque deste produto nesta unidade."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/EstoqueUnidade/verificar?estabelecimentoId=9&produtoId=48&quantidade=1
Accept: application/json

###

