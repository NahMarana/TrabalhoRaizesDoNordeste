@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Listar todos os produtos criados
//Esperado: 200
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/
Accept: application/json

###

//Buscar produto por ID
//Esperado: 200
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/5
Accept: application/json

###

//Buscar produto por nome
//Esperado: 200
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/buscar?nome=queijo
Accept: application/json

###

//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/0
Accept: application/json

###

//Buscar produto sem informando ID inválido
//Esperado: 404 - "Produto não encontrado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/999
Accept: application/json

###

//Buscar produto sem informar o nome
//Esperado: 400 - "Nome do Produto não informado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/buscar?nome=
Accept: application/json

###

//Buscar produto por nome que não existe
//Esperado: 404 - "Produto não encontrado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/produtos/buscar?nome=lasanha
Accept: application/json

