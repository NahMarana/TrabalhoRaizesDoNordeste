@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - Listar todos as pontuações
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PontosFidelidade
Accept: application/json

###

//Esperado: 200 - Busca pontuações por ID 
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PontosFidelidade/1
Accept: application/json

###

//------------ ERROS ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PontosFidelidade/0
Accept: application/json

###

//Esperado: 404 - "Pontos por fidelidade não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PontosFidelidade/9999
Accept: application/json

###
