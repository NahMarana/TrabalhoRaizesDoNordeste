@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - lista com todas as unidades criadas
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/
Accept: application/json

###

//Esperado: 200 - Buscar unidade por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/9
Accept: application/json

###

//Esperado: 200 - Buscar unidade por nome
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/buscar?nome=shopping
Accept: application/json

###

//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/0
Accept: application/json

###

//Esperado: 404 - "Unidade não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/999
Accept: application/json

###

//Esperado: 400 - "Nome da Unidade de Estabelecimento não informada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/buscar?nome=
Accept: application/json

###

//Esperado: 404 - "Unidade não encontrada." - Unidade Inexistente
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/buscar?nome=curitiba
Accept: application/json

###

//------------ ACERTOS: CONSULTAR CARDÁPIO ------------
// O cardápio mostra apenas os produtos que a unidade tem em estoque,
// com venda liberada, quantidade maior que zero, produto ativo e,
// se for sazonal, dentro do período.


//Esperado: 200 - Cardápio de unidade COMPLETA - incluindo Pratos Principais/PF
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/4/cardapio
Accept: application/json

###

//Esperado: 200 - Cardápio de unidade REDUZIDA - SEM os Pratos Principais/PF
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/9/cardapio
Accept: application/json

###


//------------ ERROS: CONSULTAR CARDÁPIO ------------

//Cardápio com ID inválido
//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/0/cardapio
Accept: application/json

###

//Cardápio de unidade que não existe
//Esperado: 404 - "Unidade não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/999/cardapio
Accept: application/json

###


