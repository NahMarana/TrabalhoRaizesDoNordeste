@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS GET ------------

//Listar todos as categorias
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/categorias/
Content-Type: application/json
Accept: application/json

###

//Buscar categoria por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/categorias/2
Content-Type: application/json
Accept: application/json

###

//Buscar categoria por nome
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/categorias/buscar?nome=pratos
Content-Type: application/json
Accept: application/json

###

//------------ ERROS GET ------------

//Buscar categoria por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/categorias/0
Content-Type: application/json
Accept: application/json

###

//Buscar categoria por nome
