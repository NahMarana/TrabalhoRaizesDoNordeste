@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - Listar todas as auditorias
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria
Accept: application/json

###

//Esperado: 200 - Buscar log por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/36
Accept: application/json

###

//------------ ERROS: BUSCA POR ID ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/0?usuarioId=7
Accept: application/json

###

//Esperado: 404 - "Auditoria não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/9999?usuarioId=7
Accept: application/json

###
