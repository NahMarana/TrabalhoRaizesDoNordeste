@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - Listar todas as auditorias
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria?usuarioId=7
Accept: application/json

###

//Esperado: 200 - Buscar log por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/36?usuarioId=7
Accept: application/json

###


//------------ ERROS: VALIDAR ACESSO ------------

//Esperado: 403 - "Somente Gerente e Administrador podem acessar as auditorias."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria?usuarioId=10
Accept: application/json

###

//Esperado: 409 - "Usuário tem que estar ativo."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria?usuarioId=15
Accept: application/json

###

//Esperado: 400 - "Usuário é obrigatório."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria
Accept: application/json

###

//Esperado: 404 - "Usuário não encontrado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria?usuarioId=9999
Accept: application/json

###


//------------ ERROS: BUSCA POR ID ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/0?usuarioId=7
Accept: application/json

###

//Esperado: 404 - "Auditoria não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/LogAuditoria/9999?usuarioId=7
Accept: application/json

###
