@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------


//Esperado: 200 - Listar todas as fidelidades
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/
Accept: application/json

###


//Esperado: 200 - Buscar a fidelidade por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/3
Accept: application/json

###

//Esperado: 200 - Consultar saldo de pontos por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/3/saldo
Accept: application/json

###

//Esperado: 200 - Pesquisar usuário com "fidelidade"
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/10
Accept: application/json

###


//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/0
Accept: application/json

###

//Esperado: 404 - "Fidelidade não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/9999
Accept: application/json

###

//Esperado: 400 - "Consultar Saldo - ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/0/saldo
Accept: application/json

###

//Esperado: 404 - "Consultar Saldo - Fidelidade não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/9999/saldo
Accept: application/json

###

//------------ FIDELIDADE TESTE ------------

// A fidelidade é criada junto com o usuário.

//Esperado: 200 - Fidelidade TESTE - usuário criado com "fidelidade"
POST {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Usuarios/
Content-Type: application/json
Accept: application/json

{
  "nome": "Cliente TESTE Fidelidade",
  "email": "cliente.teste.fidelidade@example.com",
  "cpf": "39053344705",
  "telefone": "82900000000",
  "perfil": 0,
  "rua": "Rua Jangadeiros Alagoanos",
  "numero": "410",
  "complemento": null,
  "bairro": "Pajuçara",
  "cidade": "Maceió",
  "estado": "AL",
  "cep": "57030000",
  "senha": "Teste@123456",
  "consentimentoLGPD": true,
  "participaFidelidade": true,
  "estabelecimentoId": 9
}

###

//------------ ERROS: REGRAS DA FIDELIDADE ------------

//Fidelidade não tem rota de criação própria. É criada no POST ou PATCH de usuários.
//Esperado: 405 - Method Not Allowed 
POST {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Fidelidade/
Content-Type: application/json
Accept: application/json

{
  "id": 10,
  "nome": "Neusa Bacci",
  "perfil": 0,
  "participaFidelidade": true
}

###

