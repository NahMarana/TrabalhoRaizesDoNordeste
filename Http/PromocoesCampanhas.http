@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - lista todas as promoções Ativas
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/
Accept: application/json

###

//Esperado: 200 - Listar promoção por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/1
Accept: application/json

###

//Esperado: 200 - Listar promoções invativas
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/promocoesCampanhas/inativos
Accept: application/json

###


//Esperado: 200 - Cardápio com as promoções
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/UnidadesEstabelecimento/4/cardapio
Accept: application/json

###

//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/0
Accept: application/json

###

//Esperado: 404 - "Promoção não encontrada."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/9999
Accept: application/json

###

//------------ ACERTO: CRIAÇÃO DA PROMOÇÃO ------------

// =========== Unidade Recife (4) ===========

//Esperado: 200 - promoção criada
POST {{TrabalhoRaizesDoNordeste_HostAddress}}/api/PromocoesCampanhas/
Content-Type: application/json
Accept: application/json

{
  "estabelecimentoId": 4,
  "produtoId": 7,
  "descricao": "Happy hour do dadinho",
  "valorPromocional": 18.9,
  "statusPromoCampanha": 0,
  "dataInicio": "2026-10-18",
  "dataFim": "2026-11-30"
}

###

//------------ PROMOÇÃO TESTE (usada nas atualizações e na desativação) ------------

