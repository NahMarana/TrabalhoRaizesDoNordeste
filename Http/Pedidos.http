//------------ ACERTO: CANCELAMENTO ------------

//Esperado: 200 - "Pedido cancelado com sucesso!" (Produto volta para o estoque e registra CANCELAR_PEDIDO no log)
DELETE {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/6
Accept: application/json

###

//------------ ERROS: CANCELAMENTO E PEDIDO CANCELADO ------------

