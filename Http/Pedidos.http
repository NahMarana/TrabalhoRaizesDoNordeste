###

//Alterar um pedido cancelado
//Esperado: 409 - "A alteração do pedido só é possível enquanto constar status do Pedido for PENDENTE"
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/1
Content-Type: application/json
Accept: application/json

{
  "usuarioId": 10,
  "estabelecimentoId": 4,
  "canalPedido": 3,
  "modoReceber": 1,
  "statusPedido": 0,
  "valorTotalPedido": 0,
  "descricao": "Pedido TESTE - vou buscar no balcão",
  "itensPedidos": [
    {
      "produtoId": 3,
      "qtdItens": 1
    }
  ]
}

###

//Esperado: 409 - "Pedido cancelado não pode mudar de status."
PATCH {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/1/statusPedido?statusPedido=1
Accept: application/json

