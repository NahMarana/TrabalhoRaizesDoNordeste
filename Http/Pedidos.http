@TrabalhoRaizesDoNordeste_HostAddress = http://localhost:5044

//------------ ACERTOS: GET ------------

//Esperado: 200 - Listar todos os pedidos que não foram cancelados
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/ativos
Accept: application/json

###

//Esperado: 200 - Listar pedidos cancelados
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/cancelados
Accept: application/json

###

//Esperado: 200 - Buscar pedidos por ID
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/5
Accept: application/json

###

//Esperado: 200 - Visualização do retorno do pedido do cliente
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/cliente/10
Accept: application/json

###

//Esperado: 200 - Listar pedidos por canal
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/canal?canalPedido=0
Accept: application/json

###

//------------ ERROS: GET ------------

//Esperado: 400 - "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/0
Accept: application/json

###

//Esperado: 404 - "Pedido não encontrado."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/9999
Accept: application/json

###

//Esperado: 400 - "Canal do pedido inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/canal?canalPedido=99
Accept: application/json

###

//Esperado: 400 - Retorno Cliente: "ID fornecido é inválido."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/cliente/0
Accept: application/json

###

//Esperado: 404 - Retorno Cliente: "Nenhum pedido encontrado para este cliente."
GET {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/cliente/999
Accept: application/json

###


//------------ ACERTOS: CRIAÇÃO DOS PEDIDOS ------------

//Esperado: 200 - retorno da cliente: "statusPedido": "PENDENTE", Acumula Pontos (vai gerar 4 pontos)
POST {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/
Content-Type: application/json
Accept: application/json

{
  "usuarioId": 10,
  "estabelecimentoId": 4,
  "canalPedido": 0,
  "modoReceber": 0,
  "statusPedido": 0,
  "valorTotalPedido": 0,
  "descricao": "Pedido 1 - com promoção",
  "itensPedidos": [
    {
      "produtoId": 7,
      "qtdItens": 2
    },
    {
      "produtoId": 4,
      "qtdItens": 1
    }
  ]
}

###

//Esperado: 200 - retorno da cliente: "statusPedido": "PENDENTE", Resgata pontos
POST {{TrabalhoRaizesDoNordeste_HostAddress}}/api/Pedidos/
Content-Type: application/json
Accept: application/json

{
  "usuarioId": 10,
  "estabelecimentoId": 4,
  "canalPedido": 1,
  "modoReceber": 1,
  "statusPedido": 0,
  "valorTotalPedido": 0,
  "descricao": "Pedido 2 - resgate de pontos",
  "itensPedidos": [
    {
      "produtoId": 13,
      "qtdItens": 1
    },
    {
      "produtoId": 30,
      "qtdItens": 1
    }
  ]
}

###

