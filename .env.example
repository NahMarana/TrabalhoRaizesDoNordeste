# Copie este arquivo, preencha os valores e defina como variáveis de ambiente.
# O ASP.NET Core lê variáveis com "__" (dois underlines) e elas substituem
# os valores do appsettings.json.

# JWT
Jwt__Key=troque-por-uma-chave-base64-com-no-minimo-32-bytes
Jwt__Issuer=RaizesDoNordeste
Jwt__Audience=RaizesDoNordesteClient
Jwt__ExpirationMinutes=60